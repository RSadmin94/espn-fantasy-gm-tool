{
  "manifest_version": 3,
  "name": "GM War Room — ESPN + FantasyPros",
  "version": "1.14.3",
  "description": "Connect ESPN Fantasy credentials and FantasyPros solo mock draft picks to Fantasy Football Rivals / GM War Room.",
  "permissions": ["cookies", "tabs", "scripting", "storage", "declarativeNetRequest", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://fantasy.espn.com/*",
    "https://lm-api-reads.fantasy.espn.com/*",
    "https://www.espn.com/*",
    "https://*.espn.com/*",
    "https://draftwizard.fantasypros.com/*",
    "https://www.fantasyfootballrivals.com/*",
    "https://fantasyfootballrivals.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.fantasyfootballrivals.com/*",
        "https://fantasyfootballrivals.com/*"
      ],
      "js": ["gmwarroom-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://draftwizard.fantasypros.com/*"],
      "js": ["providers/fantasypros/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://fantasy.espn.com/*",
        "https://*.espn.com/*"
      ],
      "js": ["providers/espn-live/content.bundle.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["providers/fantasypros/page-observer.js"],
      "matches": ["https://draftwizard.fantasypros.com/*"]
    },
    {
      "resources": ["providers/espn-live/board-mirror.iife.js"],
      "matches": [
        "https://fantasy.espn.com/*",
        "https://*.espn.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "GM War Room",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
