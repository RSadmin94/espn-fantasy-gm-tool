{
  "manifest_version": 3,
  "name": "Fantasy Football Rivals — ESPN Connector",
  "version": "1.14.4",
  "description": "Securely connect your ESPN Fantasy Football league to Fantasy Football Rivals.",
  "homepage_url": "https://www.fantasyfootballrivals.com",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["cookies", "declarativeNetRequest", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://fantasy.espn.com/*",
    "https://lm-api-reads.fantasy.espn.com/*",
    "https://www.espn.com/*",
    "https://*.espn.com/*",
    "https://www.fantasyfootballrivals.com/*",
    "https://fantasyfootballrivals.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.fantasyfootballrivals.com/*",
        "https://fantasyfootballrivals.com/*"
      ],
      "js": ["gmwarroom-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Fantasy Football Rivals — ESPN Connector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
